{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\*.c",
                "-I${workspaceFolder}\\build\\include",
                "-I${workspaceFolder}\\build\\include\\GLFW",
                "-I${workspaceFolder}\\build\\include\\GL",
                "-L${workspaceFolder}\\build\\lib\\GLEW",
                "-L${workspaceFolder}\\build\\lib\\GLFW",
                "-lglew32s",
                "-lglfw3dll",
                "-lopengl32",
                "-D GLEW_STATIC",
                "-o",
                "${workspaceFolder}\\bin\\rooster.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: C:\\mingw64\\bin\\gcc.exe"
        },
    ]
}